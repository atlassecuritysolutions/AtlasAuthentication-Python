# MANIFEST.in -- extra files bundled into the sdist (source distribution).
# Wheels are built from the install tree directly, so this only affects what
# `pip install atlas-auth.tar.gz` (sdist install) carries. Without this,
# `setup.py` (the install hook) wouldn't ship in the sdist and `pip install`
# from a source checkout would silently lose the binding-file updater.

include setup.py
include pyproject.toml
include README.md

# atlas/ package -- all .py sources + py.typed marker.
recursive-include atlas *.py
include atlas/py.typed
